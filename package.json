{
  "private": true,
  "workspaces": [
    "src/*",
    "src-tauri/*",
    "tests/*"
  ],
  "name": "ronmodmanager",
  "version": "0.0.18",
  "description": "Cross-platform Ready or Not mod manager built with Tauri and Svelte",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "vite dev",
    "dev:linux": "WEBKIT_DISABLE_DMABUF_RENDERER=1 LIBGL_ALWAYS_SOFTWARE=1 npm run tauri dev",
    "dev:xwayland": "GDK_BACKEND=x11 npm run tauri dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check .",
    "lint": "oxfmt --check . && npm run lint:ox && npm run lint:package-json",
    "lint:ox": "oxlint",
    "lint:package-json": "eslint .",
    "prepare": "lefthook install",
    "preview": "vite preview",
    "release": "dotenvx run -- npm run tauri build",
    "tauri": "tauri",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "version": "node scripts/sync-version.js"
  },
  "license": "MIT",
  "dependencies": {
    "@dotenvx/dotenvx": "^2.23.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@lucide/svelte": "^1.46.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-opener": "2.5.5",
    "adwavecss": "^0.2.6",
    "date-fns": "^4.4.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/json": "^2.1.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.12.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24.13.5",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-package-json": "^1.8.1",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.2.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "npm@12.1.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "allowScripts": {
    "lefthook@2.1.14": true,
    "wc_toolkit@0.1.2": true
  }
}
